{
  "manifest_version": 3,
  "name": "UNFOLLOW TRACKER",
  "version": "1.0",
  "description": "Check who unfollowed you on Instagram quickly, with a Pro system.",
  "permissions": ["storage", "activeTab", "identity"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
